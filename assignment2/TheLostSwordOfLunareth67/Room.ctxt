#BlueJ class context
comment0.target=Room
comment0.text=\n\ Represents\ a\ room\ in\ the\ game.\ \ Rooms\ have\ a\ description,\ exits\ to\ other\n\ rooms,\ a\ shop\ inventory,\ a\ monster\ (optional),\ and\ a\ list\ of\ people\n\ present.\n
comment1.params=description\ allRooms
comment1.target=Room(java.lang.String,\ java.util.List)
comment1.text=\n\ Creates\ a\ new\ Room\ object.\n\ @param\ description\ A\ short\ description\ of\ the\ room.\n\ @param\ allRooms\ A\ list\ of\ all\ rooms\ in\ the\ game\ (for\ portal\ teleportation).\n
comment10.params=
comment10.target=java.lang.String\ getShortDescription()
comment10.text=\n\ Returns\ a\ short\ description\ of\ the\ room.\n\ @return\ The\ short\ description.\n
comment11.params=
comment11.target=java.lang.String\ getLongDescription()
comment11.text=\n\ Returns\ a\ long\ description\ of\ the\ room,\ including\ exits.\n\ @return\ The\ long\ description.\n
comment12.params=
comment12.target=java.lang.String\ getExitString()
comment12.text=\n\ Returns\ a\ string\ describing\ the\ exits\ from\ this\ room.\n\ @return\ The\ exit\ string.\n
comment13.params=direction
comment13.target=Room\ getExit(java.lang.String)
comment13.text=\n\ Returns\ the\ room\ reached\ by\ going\ in\ a\ specific\ direction.\n\ @param\ direction\ The\ direction\ to\ move.\n\ @return\ The\ Room\ object\ in\ that\ direction,\ or\ null\ if\ no\ exit\ exists.\n
comment14.params=item
comment14.target=void\ addToShop(Item)
comment14.text=\n\ Adds\ an\ item\ to\ the\ shop\ inventory\ of\ this\ room.\n\ @param\ item\ The\ item\ to\ add.\n
comment15.params=itemName
comment15.target=Item\ removeFromShop(java.lang.String)
comment15.text=\n\ Removes\ an\ item\ from\ the\ shop\ inventory.\n\ @param\ itemName\ The\ name\ of\ the\ item\ to\ remove.\n\ @return\ The\ removed\ Item\ object,\ or\ null\ if\ not\ found.\n
comment16.params=itemName
comment16.target=Item\ findItemInShop(java.lang.String)
comment16.text=\n\ Finds\ an\ item\ in\ the\ shop\ inventory.\n\ @param\ itemName\ The\ name\ of\ the\ item\ to\ find.\n\ @return\ The\ Item\ object,\ or\ null\ if\ not\ found.\n
comment17.params=
comment17.target=java.util.List\ getShopInventory()
comment17.text=\n\ Returns\ the\ shop\ inventory\ of\ this\ room.\n\ @return\ The\ shop\ inventory.\n
comment18.params=
comment18.target=void\ displayShopInventory()
comment18.text=\n\ Displays\ the\ items\ available\ for\ sale\ in\ this\ room.\n
comment19.params=monster
comment19.target=void\ setMonster(Monster)
comment19.text=\n\ Sets\ the\ monster\ for\ this\ room.\n\ @param\ monster\ The\ Monster\ object\ to\ set.\n
comment2.params=
comment2.target=boolean\ hasPeople()
comment2.text=\n\ Checks\ if\ there\ are\ any\ people\ in\ this\ room.\n\ @return\ True\ if\ people\ are\ present,\ false\ otherwise.\n
comment20.params=
comment20.target=Monster\ getMonster()
comment20.text=\n\ Returns\ the\ monster\ in\ this\ room.\n\ @return\ The\ Monster\ object,\ or\ null\ if\ no\ monster\ is\ present.\n
comment21.params=
comment21.target=void\ respawnMonster()
comment21.text=\n\ Respawns\ the\ monster\ in\ this\ room\ if\ the\ room\ is\ Eryndale\ and\ the\ monster\ is\ dead\ or\ absent.\n
comment22.params=dragon
comment22.target=void\ setDragon(Dragon)
comment22.text=\n\ Sets\ the\ dragon\ for\ this\ room.\n\ @param\ dragon\ The\ Dragon\ object.\n
comment23.params=
comment23.target=Dragon\ getDragon()
comment23.text=\n\ Gets\ the\ dragon\ in\ this\ room.\n\ @return\ The\ Dragon\ object,\ or\ null.\n
comment24.params=
comment24.target=java.lang.String\ getRoomAndRouteInfo()
comment24.text=\n\ Returns\ room\ description\ and\ exits.\n\ @return\ Formatted\ description\ and\ exits.\n
comment3.params=person
comment3.target=void\ addPerson(Person)
comment3.text=\n\ Adds\ a\ person\ to\ the\ room.\n\ @param\ person\ The\ Person\ object\ to\ add.\n
comment4.params=
comment4.target=java.util.List\ getPeople()
comment4.text=\n\ Returns\ a\ list\ of\ Person\ objects\ in\ this\ room.\n\ @return\ A\ list\ of\ people\ in\ the\ room.\n
comment5.params=
comment5.target=java.lang.String\ getPersonDescription()
comment5.text=\n\ Returns\ a\ string\ describing\ the\ people\ in\ this\ room.\n\ @return\ A\ string\ describing\ the\ people,\ or\ an\ empty\ string\ if\ no\ people\ are\ present.\n
comment6.params=
comment6.target=java.util.List\ getPossibleDestinations()
comment7.params=game
comment7.target=void\ onEnter(Game)
comment7.text=\n\ Handles\ actions\ performed\ when\ the\ player\ enters\ this\ room.\ \ Currently\n\ only\ handles\ the\ Eldralis\ portal.\n\ @param\ game\ The\ Game\ object.\n
comment8.params=game
comment8.target=void\ activatePortal(Game)
comment8.text=\n\ Activates\ the\ portal\ in\ Eldralis,\ teleporting\ the\ player\ to\ a\ random\ room.\n\ @param\ game\ The\ Game\ object.\n
comment9.params=direction\ neighbor
comment9.target=void\ setExit(java.lang.String,\ Room)
comment9.text=\n\ Sets\ an\ exit\ from\ this\ room.\n\ @param\ direction\ The\ direction\ of\ the\ exit.\n\ @param\ neighbor\ The\ room\ the\ exit\ leads\ to.\n
