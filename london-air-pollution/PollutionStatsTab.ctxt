#BlueJ class context
comment0.target=PollutionStatsTab
comment0.text=\n\ A\ JavaFX\ Tab\ that\ displays\ pollution\ statistics\ through\ bar\ charts\ and\ line\ graphs.\n\ Allows\ users\ to\ select\ pollutants\ and\ years\ to\ analyze\ air\ pollution\ data.\n\ \n\ @author\ Abeer\ Hussain\n\ @version\ 1.0\n
comment1.params=tabName
comment1.target=PollutionStatsTab(java.lang.String)
comment1.text=\n\ Creates\ a\ new\ PollutionStatsTab\ with\ all\ the\ buttons.\n\n\ @param\ tabName\ The\ name\ of\ the\ tab.\n
comment10.params=
comment10.target=void\ showHighestPollutionStats()
comment10.text=\n\ Displays\ statistics\ for\ the\ highest\ pollution\ levels.\n
comment11.params=dataLoader
comment11.target=void\ setDataLoader(DataLoader)
comment11.text=\n\ Sets\ a\ custom\ DataLoader\ useful\ for\ testing\n
comment12.params=
comment12.target=java.util.Set\ getSelectedYears()
comment12.text=\n\ @return\ The\ set\ of\ selected\ years.\n
comment13.params=
comment13.target=java.lang.String\ getSelectedPollutant()
comment13.text=\n\ @return\ The\ selected\ pollutant.\n
